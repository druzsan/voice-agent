# Template for .env: copy it to .env and fill in the values there.
# .env is git-ignored. Never put real values (API keys) into this file.
#
# The backend reads the VOICE_AGENT_* variables (see backend/voice_agent/config.py);
# Docker Compose passes .env to the backend and migrate containers and also uses it
# for the ${...} values in compose.yaml. Every variable is optional: uncomment and set
# only what you need. The values shown are the defaults.

# --- App ---------------------------------------------------------------------------
# VOICE_AGENT_APP_NAME=Voice Agent
# VOICE_AGENT_VERSION=0.1.0

# --- Language model ----------------------------------------------------------------
# Provider: openai, requesty, openrouter or echo. echo repeats the caller and needs
# no key, so the app runs without any secrets.
# VOICE_AGENT_LLM_PROVIDER=echo
# Model ID as the provider lists it, required for every provider except echo,
# e.g. gpt-4.1-mini for openai, openai/gpt-4.1-mini for openrouter (always with
# the upstream provider), azure/gpt-4.1-mini@francecentral for requesty.
# Reasoning models (e.g. gpt-5-mini) answer noticeably later.
# VOICE_AGENT_LLM_MODEL=

# API key of the selected provider; the others are ignored. The keys and the
# Requesty URL may also be set without the VOICE_AGENT_ prefix (OPENAI_API_KEY,
# REQUESTY_API_KEY, OPENROUTER_API_KEY, REQUESTY_BASE_URL); the prefixed name wins.
# VOICE_AGENT_OPENAI_API_KEY=
# VOICE_AGENT_REQUESTY_API_KEY=
# VOICE_AGENT_OPENROUTER_API_KEY=
# Requesty router. Organizations with a regional policy must use theirs,
# e.g. the EU router https://router.eu.requesty.ai/v1
# VOICE_AGENT_REQUESTY_BASE_URL=https://router.requesty.ai/v1

# Seconds for one complete answer, after which a fallback reply is spoken.
# VOICE_AGENT_LLM_TIMEOUT_S=20
# Upper bound for the length of one answer. Reasoning models count their hidden
# reasoning too, so keep room for it even though spoken answers are short.
# VOICE_AGENT_LLM_MAX_TOKENS=1024
# Number of earlier messages sent to the model as conversation history.
# VOICE_AGENT_LLM_HISTORY_MESSAGES=20

# --- Speech ------------------------------------------------------------------------
# Whisper model for English speech recognition: tiny.en, base.en, small.en or
# medium.en. Larger models recognize speech more reliably but answer later.
# The backend downloads a missing model into backend/models at startup.
# VOICE_AGENT_STT_MODEL=small.en
# Beam size of the recognizer; 1 is greedy decoding, the fastest.
# VOICE_AGENT_STT_BEAM_SIZE=1
# Longest accepted recording in seconds.
# VOICE_AGENT_MAX_RECORDING_S=30

# Piper voice for speech synthesis, also downloaded into backend/models when missing.
# VOICE_AGENT_TTS_VOICE=en_US-lessac-medium

# --- Database ----------------------------------------------------------------------
# Password of the PostgreSQL user inside the Compose network. Compose builds
# VOICE_AGENT_DATABASE_URL from it, so don't set the URL here, and use only
# characters that need no escaping in a URL. It takes effect only for a new
# database volume (make clean removes the old one, with all conversations).
# POSTGRES_PASSWORD=voice_agent
