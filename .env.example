# Template: copy this file without its .example suffix and fill in the values there.
# The copy is git-ignored; never put real keys into this template.
#
# Every setting is optional. The values shown are the defaults; uncomment what you
# change. All settings, with descriptions: backend/voice_agent/config.py

# --- Language model: Requesty ----------------------------------------------------
# gpt-6.1-sol on Azure in Germany, through Requesty's EU router.
# REQUESTY_API_KEY=
# VOICE_AGENT_LLM_PROVIDER=requesty
# VOICE_AGENT_LLM_MODEL=azure/gpt-6.1-sol@germanywestcentral
# VOICE_AGENT_REQUESTY_BASE_URL=https://router.eu.requesty.ai/v1

# --- Speech recognition (STT): local or openai -----------------------------------
# local: faster-whisper on the CPU, audio stays on this machine. The model
# (tiny.en, base.en, small.en, medium.en) is downloaded into backend/models.
# VOICE_AGENT_STT_PROVIDER=local
# VOICE_AGENT_STT_MODEL=small.en
#
# openai: live calls are transcribed while the caller speaks; whole recordings
# (push-to-talk, fallback) by the file model.
# VOICE_AGENT_STT_PROVIDER=openai
# VOICE_AGENT_OPENAI_LIVE_STT_MODEL=gpt-live-transcribe
# VOICE_AGENT_OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# --- Speech synthesis (TTS): local or openai -------------------------------------
# local: Piper on the CPU; the voice is downloaded into backend/models.
# VOICE_AGENT_TTS_PROVIDER=local
# VOICE_AGENT_TTS_VOICE=en_US-lessac-medium
#
# openai: streamed as it's generated. Speed from 0.25 to 4.0; 1.0 sounds slow on
# the phone.
# VOICE_AGENT_TTS_PROVIDER=openai
# VOICE_AGENT_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# VOICE_AGENT_OPENAI_TTS_VOICE=marin
# VOICE_AGENT_OPENAI_TTS_SPEED=1.25

# Key for the openai speech providers; needs API credit on platform.openai.com.
# OPENAI_API_KEY=

# --- Customer care ----------------------------------------------------------------
# German is supported when both speech providers are openai; the local models
# are English-only. Handover routes that report "no colleague available", to try
# that path (delivery, technical_support, warranty_service, account_security,
# roadside_assistance, language_support, general):
# VOICE_AGENT_UNAVAILABLE_ROUTES=roadside_assistance
# VOICE_AGENT_TIMEZONE=Europe/Berlin

# --- Turn-taking in live calls ---------------------------------------------------
# Pause (ms) that ends the caller's turn, and speech (ms) that interrupts a reply.
# VOICE_AGENT_VAD_SILENCE_MS=800
# VOICE_AGENT_BARGE_IN_MS=400

# --- Database ----------------------------------------------------------------------
# Password of the PostgreSQL user inside the Compose network; takes effect only for
# a new database volume (make clean removes the old one, with all conversations).
# POSTGRES_PASSWORD=voice_agent
